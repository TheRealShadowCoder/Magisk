+  override fun getInstalledPackagesFromAllUsers(
+      flags: Int,
+      filterNoProcess: Boolean
+  ): ParcelableListSlice<PackageInfo> {
+    // PackageManager may not yet exist while system services are attaching on API 37.
+    // Returning an empty list here is a false success that makes all modules disappear.
+    // Force an IPC failure so the manager retains the last good list and can retry.
+    val pm = packageManager ?: throw IllegalStateException("PackageManager not initialized")
+    return ParcelableListSlice(pm.getInstalledPackagesFromAllUsers(flags, filterNoProcess))
+  }
