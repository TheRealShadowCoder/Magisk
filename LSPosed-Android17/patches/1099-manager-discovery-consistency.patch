+    fun loadModules(refresh: Boolean = false) {
+        val request = scanGeneration.incrementAndGet()
+        viewModelScope.launch {
+            _isLoading.update { true }
+            val result = withContext(Dispatchers.IO) { discover(refresh) }
+            // A slow earlier discovery must not overwrite newer package-broadcast results.
+            if (request != scanGeneration.get()) return@launch
+            _daemonAvailable.value = result.daemonAvailable
+            _scanFailed.value = result.scanFailed
+            if (result.daemonAvailable && !result.scanFailed) {
+                _discovered.value = result.tabs
+                loadFacts(result.tabs)
+            } else {
+                // A transient Binder failure is not an uninstall. Retain known-good rows.
+                logW("modules: discovery unavailable; preserving the last successful module list")
+            }
+            _isLoading.update { false }
+        }
+    }
