diff --git a/zygisk/module/customize.sh b/zygisk/module/customize.sh
--- a/zygisk/module/customize.sh
+++ b/zygisk/module/customize.sh
@@ -56,3 +56,14 @@
-VERSION=$(grep_prop version "${TMPDIR}/module.prop")
-ui_print "- Vector version ${VERSION}"
-
+VERSION=$(grep_prop version "${TMPDIR}/module.prop")
+ui_print "- Vector version ${VERSION}"
+
+# Android 17: choose ONE Zygisk implementation for the next boot.
+# Fresh installs use Auto; after manual selection the persisted choice wins.
+# Both helpers carry their own SHA256 and are verified before sourcing.
+extract "$ZIPFILE" "a17-provider-guard.sh" "$TMPDIR"
+extract "$ZIPFILE" "a17-provider-control.sh" "$TMPDIR"
+. "$TMPDIR/a17-provider-guard.sh"
+A17_SOURCE_ONLY=1
+. "$TMPDIR/a17-provider-control.sh"
+unset A17_SOURCE_ONLY
+a17_provider_preflight || abort "! Could not safely stage Zygisk provider preference"
+
@@ -85,1 +96,1 @@
-for file in module.prop action.sh service.sh uninstall.sh sepolicy.rule framework/vector.dex cli daemon.apk daemon manager.apk; do
+for file in module.prop action.sh service.sh uninstall.sh sepolicy.rule framework/vector.dex cli daemon.apk daemon manager.apk a17-provider-guard.sh a17-provider-control.sh; do
